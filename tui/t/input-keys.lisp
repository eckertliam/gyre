;;;; input-keys.lisp — decoder tables for keys: legacy bytes, Alt, CSI/SS3 sequences,
;;;; xterm modified forms and the kitty keyboard protocol.

(defpackage #:tui/tests/input-keys
  (:use #:cl)
  (:import-from #:tui/tests/input #:bytes #:key #:unknown #:row #:define-decoder-table))

(in-package #:tui/tests/input-keys)

(defun csi (&rest parts)
  "The bytes of ESC [ followed by PARTS."
  (apply #'bytes :esc "[" parts))

(define-decoder-table legacy-text-keys
  (loop for code from 32 to 126
        collect (row (bytes code) (key (code-char code))))
  (row (bytes "ab") (key #\a) (key #\b))
  (row (bytes (string (code-char 233))) (key (code-char 233)))
  (row (bytes (string (code-char #x4e2d))) (key (code-char #x4e2d)))
  (row (bytes (string (code-char #x1f600))) (key (code-char #x1f600)))
  (row (bytes #xc2 #x80) (key (code-char #x80)))
  (row (bytes #xf4 #x8f #xbf #xbf) (key (code-char #x10ffff)))
  (row (bytes (string (code-char 233)) "x") (key (code-char 233)) (key #\x)))

(define-decoder-table legacy-control-keys
  (row (bytes 0) (key #\Space :ctrl))
  (loop for byte from 1 to 26
        unless (member byte '(9 13))
          collect (row (bytes byte) (key (code-char (+ 96 byte)) :ctrl)))
  (row (bytes 8) (key #\h :ctrl))
  (row (bytes 10) (key #\j :ctrl))
  (row (bytes 9) (key :tab))
  (row (bytes 13) (key :enter))
  (row (bytes 28) (key #\4 :ctrl))
  (row (bytes 29) (key #\5 :ctrl))
  (row (bytes 30) (key #\6 :ctrl))
  (row (bytes 31) (key #\7 :ctrl))
  (row (bytes 127) (key :backspace)))

(define-decoder-table alt-keys
  (loop for code from 32 to 126
        unless (find (code-char code) "[O]P_")
          collect (row (bytes :esc code) (key (code-char code) :alt)))
  (row (bytes :esc 0) (key #\Space :ctrl :alt))
  (row (bytes :esc 1) (key #\a :ctrl :alt))
  (row (bytes :esc 26) (key #\z :ctrl :alt))
  (row (bytes :esc 28) (key #\4 :ctrl :alt))
  (row (bytes :esc 9) (key :tab :alt))
  (row (bytes :esc 13) (key :enter :alt))
  (row (bytes :esc 127) (key :backspace :alt))
  (row (bytes :esc (string (code-char 233))) (key (code-char 233) :alt))
  (row (bytes :esc (string (code-char #x1f600))) (key (code-char #x1f600) :alt))
  (row (bytes :esc :esc "[A") (key :up :alt))
  (row (bytes :esc :esc "OP") (key :f1 :alt))
  (row (bytes :esc :esc "[3~") (key :delete :alt))
  (row (bytes :esc :esc "[1;5A") (key :up :ctrl :alt))
  (row (bytes :esc :esc "[97;5u") (key #\a :ctrl :alt))
  ;; A key that already has Alt keeps the ESC prefix as an Esc key of its own.
  (row (bytes :esc :esc "[1;3A") (key :escape) (key :up :alt))
  (row (bytes :esc :esc :esc "[A") (key :escape :alt) (key :up))
  (row (bytes :esc "a" :esc "b") (key #\a :alt) (key #\b :alt)))

(define-decoder-table legacy-cursor-and-function-keys
  (row (csi "A") (key :up))
  (row (csi "B") (key :down))
  (row (csi "C") (key :right))
  (row (csi "D") (key :left))
  (row (csi "H") (key :home))
  (row (csi "F") (key :end))
  (row (csi "E") (key :keypad-begin :keypad))
  (row (csi "P") (key :f1))
  (row (csi "Q") (key :f2))
  (row (csi "R") (key :f3))
  (row (csi "S") (key :f4))
  (row (csi "Z") (key :tab :shift))
  (row (bytes :esc "OA") (key :up))
  (row (bytes :esc "OB") (key :down))
  (row (bytes :esc "OC") (key :right))
  (row (bytes :esc "OD") (key :left))
  (row (bytes :esc "OH") (key :home))
  (row (bytes :esc "OF") (key :end))
  (row (bytes :esc "OP") (key :f1))
  (row (bytes :esc "OQ") (key :f2))
  (row (bytes :esc "OR") (key :f3))
  (row (bytes :esc "OS") (key :f4)))

(define-decoder-table legacy-tilde-keys
  (loop for (number key) in '((1 :home) (2 :insert) (3 :delete) (4 :end) (5 :page-up)
                              (6 :page-down) (7 :home) (8 :end)
                              (11 :f1) (12 :f2) (13 :f3) (14 :f4) (15 :f5)
                              (17 :f6) (18 :f7) (19 :f8) (20 :f9) (21 :f10)
                              (23 :f11) (24 :f12) (25 :f13) (26 :f14) (28 :f15) (29 :f16)
                              (31 :f17) (32 :f18) (33 :f19) (34 :f20))
        collect (row (csi (format nil "~D~~" number)) (key key))))

(define-decoder-table xterm-modified-keys
  (row (csi "1;2A") (key :up :shift))
  (row (csi "1;3B") (key :down :alt))
  (row (csi "1;5C") (key :right :ctrl))
  (row (csi "1;6D") (key :left :ctrl :shift))
  (row (csi "1;9H") (key :home :super))
  (row (csi "1;17F") (key :end :hyper))
  (row (csi "1;33P") (key :f1 :meta))
  (row (csi "1;65A") (key :up :caps-lock))
  (row (csi "1;129A") (key :up :num-lock))
  (row (csi "1;2Q") (key :f2 :shift))
  (row (csi "1;5R") (key :f3 :ctrl))
  (row (csi "1;8S") (key :f4 :shift :alt :ctrl))
  (row (csi "1;5E") (key :keypad-begin :ctrl :keypad))
  (row (csi "1;5Z") (key :tab :shift :ctrl))
  (row (csi ";5A") (key :up :ctrl))
  (row (csi "5;5~") (key :page-up :ctrl))
  (row (csi "3;3~") (key :delete :alt))
  (row (csi "15;2~") (key :f5 :shift))
  (row (csi "24;5~") (key :f12 :ctrl))
  (row (csi "2;256~") (key :insert :shift :alt :ctrl :super :hyper :meta :caps-lock :num-lock))
  ;; Kitty adds the event type to the legacy forms.
  (row (csi "1;1:2A") (key :up :repeat))
  (row (csi "1;5:3A") (key :up :ctrl :release))
  (row (csi "3;1:2~") (key :delete :repeat))
  (row (csi "1;1:3P") (key :f1 :release))
  (row (csi "2;2:1~") (key :insert :shift))
  (row (csi "57427~") (key :keypad-begin :keypad)))

(define-decoder-table xterm-modify-other-keys
  (row (csi "27;5;97~") (key #\a :ctrl))
  (row (csi "27;6;65~") (key #\A :ctrl))
  (row (csi "27;6;97~") (key #\A :ctrl))
  (row (csi "27;2;32~") (key #\Space :shift))
  (row (csi "27;5;32~") (key #\Space :ctrl))
  (row (csi "27;5;13~") (key :enter :ctrl))
  (row (csi "27;5;9~") (key :tab :ctrl))
  (row (csi "27;3;27~") (key :escape :alt))
  (row (csi "27;5;127~") (key :backspace :ctrl))
  (row (csi "27;7;49~") (key #\1 :ctrl :alt)))

(define-decoder-table kitty-modifiers
  (row (csi "97u") (key #\a))
  (row (csi "97;1u") (key #\a))
  (row (csi "97;2u") (key #\A))
  (row (csi "97;3u") (key #\a :alt))
  (row (csi "97;5u") (key #\a :ctrl))
  (row (csi "97;9u") (key #\a :super))
  (row (csi "97;17u") (key #\a :hyper))
  (row (csi "97;33u") (key #\a :meta))
  (row (csi "97;65u") (key #\a :caps-lock))
  (row (csi "97;129u") (key #\a :num-lock))
  (row (csi "97;8u") (key #\A :alt :ctrl))
  (row (csi "97;66u") (key #\A :caps-lock))
  (row (csi "97;256u") (key #\A :alt :ctrl :super :hyper :meta :caps-lock :num-lock))
  ;; Shift stays when the shifted character isn't known.
  (row (csi "49;2u") (key #\1 :shift))
  (row (csi "49;6u") (key #\1 :shift :ctrl))
  (row (csi "233;2u") (key (code-char 233) :shift))
  (row (csi "13;2u") (key :enter :shift))
  (row (csi "9;2u") (key :tab :shift))
  (row (csi "57399;2u") (key #\0 :shift :keypad)))

(define-decoder-table kitty-event-types
  (row (csi "97;1:1u") (key #\a))
  (row (csi "97;1:2u") (key #\a :repeat))
  (row (csi "97;1:3u") (key #\a :release))
  (row (csi "97;5:3u") (key #\a :ctrl :release))
  (row (csi "97;:2u") (key #\a :repeat))
  (row (csi "97;1:4u") (key #\a))
  (row (csi "57441;2u") (key :left-shift :shift))
  (row (csi "57441;1:3u") (key :left-shift :release))
  (row (csi "13;1:3u") (key :enter :release)))

(define-decoder-table kitty-alternates-and-text
  (row (csi "97:65;2u") (key #\A :shifted #\A))
  (row (csi "49:33;2u") (key #\! :shifted #\!))
  (row (csi "49:33;6u") (key #\! :ctrl :shifted #\!))
  (row (csi "97::99;5u") (key #\a :ctrl :base #\c))
  (row (csi "97:65:99;2u") (key #\A :shifted #\A :base #\c))
  (row (csi "1092:1060:97;2u")
       (key (code-char 1060) :shifted (code-char 1060) :base #\a))
  (row (csi "1092::97;5u") (key (code-char 1092) :ctrl :base #\a))
  (row (csi "97:65u") (key #\a :shifted #\A))
  (row (csi "97::;5u") (key #\a :ctrl))
  (row (csi "97;;97u") (key #\a :text "a"))
  (row (csi "97;2;65u") (key #\A :text "A"))
  (row (csi "0;;104:105u") (key #\h :text "hi"))
  (row (csi "97;1;55296u") (key #\a :text (string (code-char #xfffd))))
  (row (csi "97;5;97;99u") (key #\a :ctrl :text "a")))

(define-decoder-table kitty-special-keys
  (row (csi "27u") (key :escape))
  (row (csi "27;5u") (key :escape :ctrl))
  (row (csi "13u") (key :enter))
  (row (csi "9u") (key :tab))
  (row (csi "127u") (key :backspace))
  (row (csi "127;3u") (key :backspace :alt))
  (row (csi "32u") (key #\Space))
  (row (csi "32;2u") (key #\Space :shift)))

(define-decoder-table kitty-functional-keys
  (loop for (code key)
          in '((57358 :caps-lock) (57359 :scroll-lock) (57360 :num-lock) (57361 :print-screen)
               (57362 :pause) (57363 :menu)
               (57376 :f13) (57377 :f14) (57378 :f15) (57379 :f16) (57380 :f17) (57381 :f18)
               (57382 :f19) (57383 :f20) (57384 :f21) (57385 :f22) (57386 :f23) (57387 :f24)
               (57388 :f25) (57389 :f26) (57390 :f27) (57391 :f28) (57392 :f29) (57393 :f30)
               (57394 :f31) (57395 :f32) (57396 :f33) (57397 :f34) (57398 :f35)
               (57428 :media-play) (57429 :media-pause) (57430 :media-play-pause)
               (57431 :media-reverse) (57432 :media-stop) (57433 :media-fast-forward)
               (57434 :media-rewind) (57435 :media-track-next) (57436 :media-track-previous)
               (57437 :media-record) (57438 :lower-volume) (57439 :raise-volume)
               (57440 :mute-volume)
               (57441 :left-shift) (57442 :left-control) (57443 :left-alt) (57444 :left-super)
               (57445 :left-hyper) (57446 :left-meta) (57447 :right-shift)
               (57448 :right-control) (57449 :right-alt) (57450 :right-super)
               (57451 :right-hyper) (57452 :right-meta)
               (57453 :iso-level3-shift) (57454 :iso-level5-shift))
        collect (row (csi (format nil "~Du" code)) (key key)))
  (row (csi "57376;5u") (key :f13 :ctrl)))

(define-decoder-table kitty-keypad-keys
  (loop for (code key)
          in '((57399 #\0) (57400 #\1) (57401 #\2) (57402 #\3) (57403 #\4) (57404 #\5)
               (57405 #\6) (57406 #\7) (57407 #\8) (57408 #\9) (57409 #\.) (57410 #\/)
               (57411 #\*) (57412 #\-) (57413 #\+) (57414 :enter) (57415 #\=) (57416 #\,)
               (57417 :left) (57418 :right) (57419 :up) (57420 :down) (57421 :page-up)
               (57422 :page-down) (57423 :home) (57424 :end) (57425 :insert) (57426 :delete)
               (57427 :keypad-begin))
        collect (row (csi (format nil "~Du" code)) (key key :keypad)))
  (row (csi "57400;5u") (key #\1 :ctrl :keypad))
  (row (csi "57414;1:3u") (key :enter :release :keypad)))

(define-decoder-table unrecognized-keys
  (row (csi ";5u") (unknown :esc "[;5u"))
  (row (csi "0u") (unknown :esc "[0u"))
  (row (csi "1114112u") (unknown :esc "[1114112u"))
  (row (csi "55296u") (unknown :esc "[55296u"))
  (row (csi "57364u") (unknown :esc "[57364u"))
  (row (csi "2A") (unknown :esc "[2A"))
  (row (csi "9~") (unknown :esc "[9~"))
  (row (csi "201~") (unknown :esc "[201~"))
  (row (csi "27;5~") (unknown :esc "[27;5~"))
  (row (bytes :esc "Ox") (unknown :esc "Ox")))
